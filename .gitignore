# Virtual environments
# The only supported location is .venv/, created by ./setup.sh.
# A venv created in place at the repo root is NOT ignored on purpose:
# it shows up in `git status` so it gets removed instead of hidden.
.venv/
venv/
env/


# Python bytecode
__pycache__/
*.py[cod]

# Build artifacts
build/
dist/
*.egg-info/

# Testing and tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local configuration
.env
.env.*
!.env.example

# IDE
.idea/
.vscode/
