// --------------------------------------------------------------------------
// Program structure
// -------------------------------------------------------------------------- */

start            : _block_list

_block_list         : (_newlines _block _newlines)*

_block              : processes_block
                     | messages_block
                     | history_block

// --------------------------------------------------------------------------
// Blocks
// -------------------------------------------------------------------------- */

processes_block    : _PROCESSES "{" _newlines _process_decl_list "}"

_process_decl_list  : (process_declaration _newlines)*

messages_block     : _MESSAGES "{" _newlines _message_decl_list _newlines "}"

_message_decl_list  : (message_decl _newlines)*

message_decl       : message_name _DEFINED message_value

history_block      : _HISTORY "{" _newlines _event_list _newlines "}"

_event_list         : (event)*

// --------------------------------------------------------------------------
// History events
// -------------------------------------------------------------------------- */

event              : send_event _newlines
                   | recv_event _newlines

//  Send — e.g.
//      m2 := Send(ack) :: q -> p, q, r
//  Binds the event name to the sending of a declared message by a
//  declared process to every process in the target list; a target
//  list with several names denotes a multicast.                        */

send_event         : event_identifier _DEFINED _SEND "(" message_identifier ")" _IN process_identifier _TO process_list

//  Recv — e.g.
//      Recv(m1) :: q
//      Recv(m1) :: q        (equivalent dotted spelling)
//      Recv(m2) :: p, q     (sugar for `Recv m2 :: p` and `Recv m2 :: q`)
//  Records that every process in the list received the message bound
//  to the referenced event.                                             */

recv_event         : "Recv" "(" event_identifier ")" _IN process_list

process_list       : process_identifier ("," process_identifier)*

//  All three name spaces are plain identifiers syntactically.            */

process_declaration : IDENTIFIER
message_name : IDENTIFIER
message_identifier : IDENTIFIER
message_value      : STRING
event_name         : IDENTIFIER
event_identifier   : IDENTIFIER
process_identifier : IDENTIFIER

// --------------------------------------------------------------------------
// Lexical syntax
// -------------------------------------------------------------------------- */

//  String literal — a double-quoted sequence of characters.  Any
//  character may appear between the quotes except the double quote
//  itself and a line terminator; there are no escape sequences.        */

_newlines : _NL _newlines
          |

STRING : /".*?"/
IDENTIFIER : /[a-z][a-zA-Z0-9_]*/

_NL : /\r?\n/
_PROCESSES: "Processes"
_MESSAGES: "Messages"
_HISTORY: "History"
_IN: "::"
_TO: "->"
_DEFINED: ":="
_SEND: "Send"
_RECV: "Recv"

%ignore /[ \t]/
