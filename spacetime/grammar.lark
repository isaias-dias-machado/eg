// --------------------------------------------------------------------------
// Syntax + semantics: an attribute grammar in comments (documentation only,
// not executed).  Each ER block copies the data flow at that level: inherited
// attributes down to the children, synthesized attributes up to the parent.
//
//   ER { stmts; }          evaluation rules of the production above
//   CC { cond -> "msg"; }  context condition: cond must hold, else "msg"
//
// A child occurring once is referenced by name (expr.env = ...); a repeated
// child uses rule[i], 1-based (decls[1].val); children(rule) iterates every
// child matching `rule`, in source order.
//
// procs       declared process names, in declaration order
// msgs        message name -> payload
// seen_sends  send-event name -> recipients, for the sends seen so far
//
// Blocks may appear in any order, so procs/msgs are synthesized up to
// `start` and inherited back down; seen_sends is inherited along the event
// list in source order.  Process, message and event names are separate
// namespaces.  Pure syntax errors are rejected by the CFG itself, before
// any attribute is evaluated.
// --------------------------------------------------------------------------

// --------------------------------------------------------------------------
// Program structure
// --------------------------------------------------------------------------

start            :  (processes_block | messages_block | history_block)*
// ER {
//   start.procs = [p for b in children(processes_block) for p in b.procs];
//   start.msgs  = {k: v for b in children(messages_block) for k, v in b.msgs.items()};
//   for b in children(history_block): b.procs = start.procs; b.msgs = start.msgs;
// }
// CC {
//   len(children(processes_block)) <= 1 -> "duplicate Processes block";
//   len(children(messages_block))  <= 1 -> "duplicate Messages block";
//   len(children(history_block))   <= 1 -> "duplicate History block";
// }

// --------------------------------------------------------------------------
// Blocks
// --------------------------------------------------------------------------

processes_block  : _PROCESSES "{" process_declaration* "}"
// ER {
//   processes_block.procs = [d.name for d in children(process_declaration)];
// }
// CC {
//   len(set(processes_block.procs)) == len(processes_block.procs) -> "duplicate process declaration";
// }

messages_block   : _MESSAGES "{" message_decl* "}"
// ER {
//   messages_block.msgs = {k: v for d in children(message_decl) for k, v in d.entry.items()};
// }
// CC {
//   len(messages_block.msgs) == len(children(message_decl)) -> "duplicate message declaration";
// }

message_decl     : message_name _DEFINED message_value
// ER {
//   message_decl.entry = {message_name.name: message_value.value};
// }

history_block    : _HISTORY "{"  event* "}"
// ER {
//   for e in children(event): e.procs = history_block.procs; e.msgs = history_block.msgs;
//   event[1].seen_sends = {};
//   for k in range(2, len(children(event)) + 1):
//     event[k].seen_sends = event[k-1].seen_sends | event[k-1].sends;
// }

// --------------------------------------------------------------------------
// History events
// --------------------------------------------------------------------------

event            : send_event
// ER {
//   send_event.procs      = event.procs;
//   send_event.msgs       = event.msgs;
//   send_event.seen_sends = event.seen_sends;
//   event.sends           = send_event.sends;
// }
                 | recv_event
// ER {
//   recv_event.procs      = event.procs;
//   recv_event.msgs       = event.msgs;
//   recv_event.seen_sends = event.seen_sends;
//   event.sends           = recv_event.sends;
// }

// m2 := Send(ack) :: q -> p, q, r   (multicast allowed)
send_event       : event_identifier _DEFINED _SEND "(" message_identifier ")" _IN process_identifier _TO process_list
// ER {
//   send_event.sends = {event_identifier.name: process_list.names};
// }
// CC {
//   message_identifier.name in send_event.msgs -> f"undeclared message: '{message_identifier.name}'";
//   process_identifier.name in send_event.procs -> f"undeclared process: '{process_identifier.name}'";
//   for p in process_list.names: p in send_event.procs -> f"undeclared process: '{p}'";
//   event_identifier.name not in send_event.seen_sends -> f"duplicate event declaration: '{event_identifier.name}'";
// }

// Recv(m1) :: q   (kept as one event even for several processes)
recv_event       : _RECV "(" event_identifier ")" _IN process_list
// ER {
//   recv_event.sends = {};
// }
// CC {
//   event_identifier.name in recv_event.seen_sends -> f"undeclared send event: '{event_identifier.name}'";
//   for p in process_list.names: p in recv_event.procs -> f"undeclared process: '{p}'";
//   for p in process_list.names: p in recv_event.seen_sends[event_identifier.name] -> f"process '{p}' is not a recipient of send event '{event_identifier.name}'";
// }

process_list     : process_identifier ("," process_identifier)*
// ER {
//   process_list.names = [p.name for p in children(process_identifier)];
// }

// --------------------------------------------------------------------------
// Names and values
// --------------------------------------------------------------------------

process_declaration : IDENTIFIER
message_name        : IDENTIFIER
message_identifier  : IDENTIFIER
message_value       : STRING
event_identifier    : IDENTIFIER
process_identifier  : IDENTIFIER

STRING : /".*?"/
IDENTIFIER : /[a-z][a-zA-Z0-9_]*/

_PROCESSES  : "Processes"
_MESSAGES   : "Messages"
_HISTORY    : "History"
_IN         : "::"
_TO         : "->"
_DEFINED    : ":="
_SEND       : "Send"
_RECV       : "Recv"

%ignore /[ \t\n]/

// ingore comments
%ignore /\/\/[^\n\r]*/ | /\/\*([^*]|\*[^\/])*\*\//
